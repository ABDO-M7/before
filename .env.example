# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================

# Web Version (Do not Change)
NEXT_PUBLIC_WEB_VERSION="2.6.0"

# Admin panel / API URL (backend)
NEXT_PUBLIC_API_URL="http://localhost/arablaza_admin_panel/public"
# NEXT_PUBLIC_API_URL="https://app.arablaza.com"

# Website URL (this Next.js app)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
# NEXT_PUBLIC_WEB_URL="https://arablaza.com"

# API ENDPOINT (Do not change)
NEXT_PUBLIC_END_POINT="/api/"

# Firebase config - get from Firebase Console > Project Settings
NEXT_PUBLIC_API_KEY=your_firebase_api_key
NEXT_PUBLIC_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_PROJECT_ID=your_project_id
NEXT_PUBLIC_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_APP_ID=1:your_sender_id:web:your_app_id
NEXT_PUBLIC_MEASUREMENT_ID=G-XXXXXXXXXX

# Performance / feature flags (optional)
ANALYZE=false
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_ENABLE_RUM_TRACKING=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_METADATA_CACHE_TTL=3600
NEXT_PUBLIC_API_CACHE_TTL=300
NEXT_PUBLIC_ENABLE_PREFETCHING=true
NEXT_PUBLIC_PREFETCH_HOVER_DELAY=150
NEXT_PUBLIC_ENABLE_VIRTUAL_SCROLLING=true
NEXT_PUBLIC_VIRTUAL_SCROLLING_THRESHOLD=30
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_VERBOSE_LOGGING=true

# VAPID key (Web Push) - from Firebase Cloud Messaging or web-push
NEXT_PUBLIC_VAPID_KEY=your_vapid_public_key

# Default country code (ISO 3166-1 alpha-2, lowercase, e.g. sy, in, eg)
NEXT_PUBLIC_DEFAULT_COUNTRY=sy

# SEO (optional overrides)
NEXT_PUBLIC_META_TITLE="Arablaza - Buy & Sell Marketplace"
NEXT_PUBLIC_META_DESCRIPTION="Your marketplace description."
NEXT_PUBLIC_META_kEYWORDS="marketplace, buy, sell, ..."

# Google OAuth - from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Analytics & tracking (optional - leave empty to disable; no production IDs in source)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
